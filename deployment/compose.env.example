# Copy this file to /opt/aiweb/compose.env on the server.
# Set the value to the Docker network already used by the existing Caddy container.
#
# Discover it with:
#   docker inspect caddy --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}'
#
# Common values are "sub2api_default", "caddy", or the Compose project network name.
AIWEB_CADDY_NETWORK=sub2api_default

# These are build-time public values embedded into the browser bundle.
# Keep them here as non-secret deployment knobs; runtime env_file changes alone do not update them.
NEXT_PUBLIC_LDXP_PLUS_URL=https://pay.ldxp.cn/item/knq3lq
NEXT_PUBLIC_LDXP_PRO_URL=https://pay.ldxp.cn/item/c0zh71
